# FlemingCore Environment Variables
# Copiar para .env local (NÃO commitar!)

# --- Desativadas abaixo: chaves reservadas pelo Firebase Functions ---
# O deploy falha com "Key GCP_PROJECT is reserved for internal use" e
# "starts with a reserved prefix (X_GOOGLE_ FIREBASE_ EXT_)".
# Os mesmos valores ja sao o default no main.py, entao o runtime nao muda.
#GCP_PROJECT=flemingcore-53272
#FIREBASE_PROJECT_ID=flemingcore-53272
#FIREBASE_STORAGE_BUCKET=flemingcore-53272.appspot.com

# Database — conexão via IP público (decisão de custo, sem VPC Connector)
# Se testar localmente, seu IP precisa estar autorizado no Cloud SQL em "Redes autorizadas"
# Senha NUNCA aqui — sempre via Secret Manager (get_secret("db-password"))
DB_HOST=<ip-publico-do-cloud-sql>
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres

# AI Models
# gemini-2.0-flash foi desativado em 01/06/2026 — usa alias "latest"
GEMINI_MODEL=gemini-flash-latest

# Firebase Realtime Database — obrigatório, sem isso rtdb.reference().set() falha silenciosamente
# Desativada: prefixo FIREBASE_ e reservado pelo Firebase Functions.
# Mesmo valor ja e o default no main.py (DATABASE_URL), rtdb aponta pro mesmo lugar.
#FIREBASE_DATABASE_URL=https://flemingcore-53272-default-rtdb.firebaseio.com

# Pub/Sub Topics
PUBSUB_TOPIC_EMAIL=alertas-email
PUBSUB_TOPIC_FCM=alertas-fcm

# Secrets (NUNCA valores reais aqui — só lembrete do que existe no Secret Manager)
# db-password, gemini-api-key, gmail-oauth-credentials, sap-api-key

# Logging
LOG_LEVEL=INFO

DEBUG=false
